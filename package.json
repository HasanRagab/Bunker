{
  "name": "@2hasan2/bunker",
  "version": "0.1.1",
  "type": "module",
  "description": "Typed, composable backend toolkit for Bun, TypeScript, and Zod.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HasanRagab/Bunker.git"
  },
  "bugs": {
    "url": "https://github.com/HasanRagab/Bunker/issues"
  },
  "homepage": "https://github.com/HasanRagab/Bunker#readme",
  "engines": {
    "bun": ">=1.2.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "example",
    "src",
    "drizzle",
    "drizzle.config.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun --watch example/app.ts",
    "check": "tsc -p .",
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json && tsc-esm-fix --tsconfig tsconfig.build.json",
    "verify": "bun run check && bun test && bun run build",
    "pack:check": "npm pack --dry-run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish-packages": "changeset publish",
    "prepublishOnly": "bun run verify",
    "prepack": "bun run build"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11",
    "tsc-esm-fix": "^3.1.2",
    "typescript": "^5.6.0"
  }
}
